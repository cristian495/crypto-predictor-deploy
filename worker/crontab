# Planificacion del worker de señales (paper trading).
# Las variables de entorno reales se inyectan en /etc/environment desde el entrypoint,
# porque cron NO hereda el entorno del contenedor por defecto.
# Salida -> /proc/1/fd/1 (stdout de PID 1) para que aparezca en `docker logs`.

# scan: cada hora al minuto 2 (tras el cierre de la vela 1H + margen de publicacion de Binance)
2 * * * * . /etc/environment; /app/run-task.sh scan  > /proc/1/fd/1 2>&1

# resolve: cada 6 horas al minuto 20 (resuelve señales que ya maduraron)
20 */6 * * * . /etc/environment; /app/run-task.sh resolve > /proc/1/fd/1 2>&1

# export: 1x/dia a las 03:30 UTC (backtest/signals/portfolio JSON para la UI). Pesado.
30 3 * * * . /etc/environment; /app/run-task.sh export  > /proc/1/fd/1 2>&1
