# predictor-deploy — config del entorno. Copia a .env y edita. .env NUNCA se versiona.
# Correr desde ~/deploys/predictor/<env> en el VPS.

# ── Repos (clonados por bootstrap.sh a repos/) ───────────────────────────────
ENGINE_REPO=https://github.com/cristian495/crypto-predictor.git
ENGINE_BRANCH=main

# Repo de la UI.
UI_REPO=https://github.com/cristian495/crypto-predictor-ui.git
UI_BRANCH=main

# ── Aislamiento de entorno (nombra el stack y los volumenes) ──────────────────
# production: predictor_production  ·  staging: predictor_staging
COMPOSE_PROJECT_NAME=predictor_production

# ── Zona horaria del contenedor (para los logs; la estrategia usa UTC internamente) ──
TZ=UTC

# ── Web (UI) ─────────────────────────────────────────────────────────────────
# Puerto loopback del host al que el Nginx del host hace proxy.
WEB_PORT=3020
# Dominio (zona Cloudflare con Origin cert) y subdominio de la UI.
DOMAIN=example.com
APP_HOST=predictor.${DOMAIN}

# ── Secreto: webhook de Discord para alertas ─────────────────────────────────
# Ajustes del canal -> Integraciones -> Webhooks -> Nuevo webhook -> Copiar URL.
# Es un SECRETO. Si lo dejas vacio, el worker registra señales pero NO alerta.
DISCORD_WEBHOOK_URL=
